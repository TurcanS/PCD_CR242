
import java.util.Random;

public class Main {

    public static void main(String[] args) {

        // ==========================================
        // INFORMATII DESPRE STUDENTI
        // ==========================================

        String grupa = "CR-242";

        String[] studenti = {
                "Spînu Veniamin",
                "Demenco Octavian"
        };


        // ==========================================
        // CREAREA TABLOULUI COMUN
        // 100 DE NUMERE INTRE 1 SI 100
        // ==========================================

        int[] mas = new int[100];

        Random random = new Random();

        System.out.println("TABLOUL mas[]:");
        System.out.println();

        for (int i = 0; i < mas.length; i++) {

            // Numere intre 1 si 100
            mas[i] = random.nextInt(100) + 1;

            System.out.print(mas[i] + " ");
        }

        System.out.println();
        System.out.println();


        // ==========================================
        // MEMBRUL 1 AL ECHIPEI
        // ==========================================

        Membru1 membru1 = new Membru1(mas);


        // ==========================================
        // MEMBRUL 2 AL ECHIPEI
        // ==========================================

        Membru2 membru2 = new Membru2(mas);


        // ==========================================
        // CREAREA CELOR 4 FIRE
        // ==========================================

        Thread th1Membru1 =
                new Thread(
                        membru1::conditia1,
                        "Th1 - Membru 1"
                );

        Thread th2Membru1 =
                new Thread(
                        membru1::conditia2,
                        "Th2 - Membru 1"
                );


        Thread th1Membru2 =
                new Thread(
                        membru2::conditia1,
                        "Th1 - Membru 2"
                );

        Thread th2Membru2 =
                new Thread(
                        membru2::conditia2,
                        "Th2 - Membru 2"
                );


        // ==========================================
        // PORNIREA CELOR 4 FIRE
        // ==========================================

        System.out.println("=================================");
        System.out.println("PORNIREA FIRELOR");
        System.out.println("=================================");

        th1Membru1.start();
        th2Membru1.start();

        th1Membru2.start();
        th2Membru2.start();


        // ==========================================
        // FIRUL PRINCIPAL ASTEAPTA
        // TERMINAREA CELOR 4 FIRE
        // ==========================================

        try {

            th1Membru1.join();
            th2Membru1.join();

            th1Membru2.join();
            th2Membru2.join();

        } catch (InterruptedException e) {

            e.printStackTrace();
        }


        // ==========================================
        // DUPA TERMINAREA CELOR 4 FIRE
        // AFISAM STUDENTII
        // LITERA CU LITERA LA 100 ms
        // ==========================================

        System.out.println();
        System.out.println("=================================");
        System.out.println("INFORMATII DESPRE STUDENTI");
        System.out.println("=================================");

        afisareLenta("Grupa: " + grupa);

        afisareLenta("Studenti:");

        for (String student : studenti) {

            afisareLenta(student);
        }

        System.out.println("=================================");
        System.out.println("PROGRAM TERMINAT");
        System.out.println("=================================");
    }


    // ==========================================
    // AFISARE LITERA CU LITERA
    // CU PAUZA DE 100 ms
    // ==========================================

    public static void afisareLenta(String text) {

        for (int i = 0; i < text.length(); i++) {

            System.out.print(text.charAt(i));

            try {

                Thread.sleep(100);

            } catch (InterruptedException e) {

                e.printStackTrace();
            }
        }

        System.out.println();
    }
}


// ==================================================
// CLASA MEMBRUL 1
// ==================================================

class Membru1 {

    private int[] mas;


    // ==========================================
    // CONSTRUCTOR
    // ==========================================

    public Membru1(int[] mas) {

        this.mas = mas;
    }


    // ==========================================
    // Th1
    //
    // CONDITIA 1:
    //
    // Sumele produselor numerelor de pe pozitii
    // pare doua cate doua, incepand cautarea
    // si sumarea cu primul element
    // ==========================================

    public void conditia1() {

        int suma = 0;

        System.out.println();
        System.out.println(
                Thread.currentThread().getName()
                        + " -> Conditia 1"
        );


        // Pozitiile pare:
        //
        // 0 si 2
        // 4 si 6
        // 8 si 10
        // 12 si 14
        // etc.

        for (int i = 0; i <= 96; i += 4) {

            int poz1 = i;
            int poz2 = i + 2;


            // Calculam produsul
            int produs =
                    mas[poz1] * mas[poz2];


            // Adaugam produsul la suma
            suma = suma + produs;


            // Afisam rezultatul
            System.out.println(
                    Thread.currentThread().getName()
                            + " | pozitii: "
                            + poz1
                            + " si "
                            + poz2
                            + " | valori: "
                            + mas[poz1]
                            + " * "
                            + mas[poz2]
                            + " = "
                            + produs
            );
        }


        // Afisam suma
        System.out.println(
                Thread.currentThread().getName()
                        + " | SUMA = "
                        + suma
        );
    }


    // ==========================================
    // Th2
    //
    // CONDITIA 2:
    //
    // Sumele produselor numerelor de pe pozitii
    // pare doua cate doua, incepand cautarea
    // si sumarea cu ultimul element
    // ==========================================

    public void conditia2() {

        int suma = 0;

        System.out.println();
        System.out.println(
                Thread.currentThread().getName()
                        + " -> Conditia 2"
        );


        // Pozitiile pare de la sfarsit:
        //
        // 98 si 96
        // 94 si 92
        // 90 si 88
        // 86 si 84
        // etc.

        for (int i = 98; i >= 2; i -= 4) {

            int poz1 = i;
            int poz2 = i - 2;


            // Calculam produsul
            int produs =
                    mas[poz1] * mas[poz2];


            // Adaugam produsul la suma
            suma = suma + produs;


            // Afisam rezultatul
            System.out.println(
                    Thread.currentThread().getName()
                            + " | pozitii: "
                            + poz1
                            + " si "
                            + poz2
                            + " | valori: "
                            + mas[poz1]
                            + " * "
                            + mas[poz2]
                            + " = "
                            + produs
            );
        }


        // Afisam suma
        System.out.println(
                Thread.currentThread().getName()
                        + " | SUMA = "
                        + suma
        );
    }
}


