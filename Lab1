import java.util.*;

public class Main {
    public static void main(String args[]) {

        String grupa = "CR-242";

        String[] studenti = {
                "Spînu Veniamin",
                "Demenco Octavian",
        };

        System.out.println("Grupa: " + grupa);
        System.out.println("Studenti:");

        for (String student : studenti) {
            System.out.println(student);
        }

        System.out.println();

        // CREAREA TABLOULUI DE 100 DE NUMERE
        int[] tablou = new int[100];

        System.out.println("Numerele din tablou:");

        for (int i = 0; i < 100; i++) {
            tablou[i] = (int) (Math.random() * 99);
            System.out.print(tablou[i] + " ");
        }

        System.out.println("\n");

        // SARCINA 1 Suma produselor numerelor aflate pe
        // pozitii pare, doua cate doua,
        // incepand cu primul element

        Counter1 fir1 = new Counter1(
                0,       // incepe de la primul element
                99,      // pana la ultimul element
                1,       // merge inainte
                tablou,
                1        // numarul sarcinii
        );

        fir1.setName("Sarcina 1: ");
        fir1.start();

        // SARCINA 2 Suma produselor numerelor aflate pe
        // pozitii pare, doua cate doua,
        // incepand cu ultimul element

        Counter1 fir2 = new Counter1(
                99,      // incepe de la ultimul element
                0,       // pana la primul element
                -1,      // merge inapoi
                tablou,
                2        // numarul sarcinii
        );

        fir2.setName("Sarcina 2: ");
        fir2.start();

        try {
            fir1.join();
            fir2.join();

        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        System.out.println();

        System.out.println("REZULTATE FINALE");
        System.out.println(
                "Suma sarcina 1 = " + fir1.getSuma()
        );

        System.out.println(
                "Suma sarcina 2 = " + fir2.getSuma()
        );

    }
}

class Counter1 extends Thread {
    private int from;
    private int to;
    private int step;
    private int[] tablou;
    private int sarcina;

    private int suma;

    public Counter1(
            int from,
            int to,
            int step,
            int[] tablou,
            int sarcina) {

        this.from = from;
        this.to = to;
        this.step = step;
        this.tablou = tablou;
        this.sarcina = sarcina;

        suma = 0;
    }

    public void run() {

        int j = from;

        // Parcurgem tabloul
        while ((step > 0 && j <= to) ||
                (step < 0 && j >= to)) {

            if (j % 2 == 0) {

                // Retinem pozitia primului element
                int primul = j;

                // Trecem la urmatoarea pozitie
                j += step;

                // Cautam a doua pozitie para
                while ((step > 0 && j <= to) ||
                        (step < 0 && j >= to)) {

                    if (j % 2 == 0) {

                        // Retinem pozitia celui de-al doilea element
                        int alDoilea = j;

                        // Calculam produsul valorilor
                        int produs =
                                tablou[primul] *
                                        tablou[alDoilea];

                        // Adaugam produsul la suma
                        suma = suma + produs;

                        // Afisam perechea
                        System.out.println(
                                getName()
                                        + "pozitii: "
                                        + primul
                                        + " si "
                                        + alDoilea
                                        + " | valori: "
                                        + tablou[primul]
                                        + " * "
                                        + tablou[alDoilea]
                                        + " = "
                                        + produs
                        );
                        // Am gasit a doua pozitie para
                        break;
                    }
                    j += step;
                }
            }

            j += step;
        }

        // Afisam suma calculata de acest fir
        System.out.println(
                getName()
                        + "Suma = "
                        + suma
        );
    }

    public int getSuma() {
        return suma;
    }
}
